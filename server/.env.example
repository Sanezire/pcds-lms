PORT=4000
NODE_ENV=development

# Browser origin allowed to call the API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pcds_lms
DB_PASSWORD=change-me
DB_NAME=pcds_lms

# Session lifetime in hours
SESSION_TTL_HOURS=8
COOKIE_NAME=pcds_sid

# Minutes ahead of UTC for local time (Philippines = 480). Sets where an attendance day ends.
ATTENDANCE_UTC_OFFSET_MINUTES=480

# bcrypt cost factor (12 is a solid default)
BCRYPT_ROUNDS=12

# Secret required on the /register page to create an administrator account.
# Use a long random value and keep it private. Leave empty to turn registration off.
ADMIN_REGISTRATION_KEY=change-this-to-a-long-random-key

# Used only by `npm run seed:admin`
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@pcds.edu
SEED_ADMIN_ID=ADMIN-001
SEED_ADMIN_PASSWORD=ChangeThisNow123
