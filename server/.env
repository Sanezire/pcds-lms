PORT=4000
NODE_ENV=development

# Browser origin allowed to call the API (the Vite dev server by default)
CLIENT_ORIGIN=http://192.168.8.198:5173
#http://localhost:5173

# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pcds_lms

# Session lifetime in hours
SESSION_TTL_HOURS=8
COOKIE_NAME=pcds_sid

# Minutes ahead of UTC for local time (Philippines = 480). Sets where an attendance day ends.
ATTENDANCE_UTC_OFFSET_MINUTES=480

# Library operating hours (local time, 24-hour clock) and closed days.
# Used by Peak Library Usage: visits outside these times are not counted in its charts.
# LIBRARY_CLOSED_DAYS: comma-separated, e.g. sun or sat,sun
LIBRARY_OPEN_HOUR=8
LIBRARY_CLOSE_HOUR=17
LIBRARY_CLOSED_DAYS=sun

# bcrypt cost factor (12 is a solid default)
BCRYPT_ROUNDS=12

# Used only by `npm run seed:admin`
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@pcds.edu
SEED_ADMIN_ID=ADMIN-001
SEED_ADMIN_PASSWORD=Pcds_admin123

# Key required on the /register page to create Admin and SA accounts
ADMIN_REGISTRATION_KEY=123456789
# Super admin mamenn
SEED_SUPER_ADMIN_NAME=Sanezire
SEED_SUPER_ADMIN_EMAIL=sanezire@gmail.com
SEED_SUPER_ADMIN_ID=SUPERADMIN-001
SEED_SUPER_ADMIN_PASSWORD=Sanezire_admin123